--- a/src/commands/lifecycle.rs
+++ b/src/commands/lifecycle.rs
@@ -116,6 +116,17 @@
         crate::commands::render_summary(&summary);
     }
 
+    // A host that failed or rolled back must fail the process: the summary is an audit record, not an
+    // exit status, and automation only sees the status.
+    let unsuccessful = summary.failed() + summary.rolled_back();
+    if !params.dry_run && unsuccessful > 0 {
+        return Err(NodError::deployment(format!(
+            "{} of {} host(s) did not deploy successfully",
+            unsuccessful,
+            summary.outcomes.len()
+        )));
+    }
+
     Ok(())
 }
 
