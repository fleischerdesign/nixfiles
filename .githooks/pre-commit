#!/usr/bin/env bash
# Format and lint the Nix files that are staged for this commit.
#
# The repository's own rule is that a check must be able to fail loudly, and a partial staging is the
# quiet failure here: `nixfmt` rewrites the whole file, so re-staging it would also stage the hunks the
# author deliberately left out. A file that has unstaged changes is therefore refused instead of being
# reformatted - the author stages or stashes it, and nothing enters the commit unnoticed. The full
# tree is checked by `nix flake check` (the `format` check), so a hook that is not installed cannot
# turn formatting drift into a silent, permanent state.
set -euo pipefail

mapfile -d '' -t changed < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.nix')

if [ "${#changed[@]}" -eq 0 ]; then
  exit 0
fi

refused=0
for file in "${changed[@]}"; do
  if ! git diff --quiet -- "$file"; then
    echo "pre-commit: $file has unstaged changes; stage or stash them before committing" >&2
    refused=1
  fi
done
[ "$refused" -eq 0 ] || exit 1

echo "==> nixfmt"
nixfmt "${changed[@]}"
git add -- "${changed[@]}"

echo "==> deadnix"
deadnix --fail "${changed[@]}"

echo "==> statix"
# statix accepts a single target, so a commit that stages several Nix files
# needs one invocation per file; passing them all aborts the hook before it
# lints anything.
for file in "${changed[@]}"; do
  statix check "$file"
done
